        "@tailwindcss/vite": "^4.3.3",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.11.0",
        "@types/turndown": "^5.0.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.12.0",
